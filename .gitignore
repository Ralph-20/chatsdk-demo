# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# workflow devkit (build-generated)
app/.well-known/workflow/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local dev tooling — cached SDK docs + installed agent skills (see README)
.docs/
.agents/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Local agent-browser/playwright MCP scratch
.playwright-mcp/

# internal scratch (scope, client context, impl logs)
.context/
